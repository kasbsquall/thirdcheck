# Copy to .env and fill in. .env is gitignored and must never be committed.

# Creditcoin CC3 testnet. Chain id 102031. This is where the precompile lives.
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# Ethereum Sepolia, the source chain. Chain id 11155111.
# A public endpoint will rate-limit during proof generation. Use Alchemy or Infura.
SEPOLIA_RPC_URL=

# Attestcoin proof builder service for CC3 testnet.
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network

# Deployer key. Testnet only, funded from the faucet. Never a key that holds real value.
DEPLOYER_PRIVATE_KEY=

# Filled in as contracts get deployed.
VULNERABLE_ESCROW_ADDRESS=
HARDENED_ESCROW_ADDRESS=
SOURCE_REGISTRY_ADDRESS=
